# Copy to .env and adjust. All settings are optional.

# Telegram: create a bot with @BotFather, send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
SNIFLOT_TELEGRAM_BOT_TOKEN=
SNIFLOT_TELEGRAM_CHAT_ID=

# Basic auth for the whole app (recommended if reachable from your LAN)
SNIFLOT_AUTH_USER=
SNIFLOT_AUTH_PASSWORD=

# Timezone for the UI
SNIFLOT_TZ=Europe/Moscow

# Default check intervals, minutes
SNIFLOT_SEARCH_INTERVAL=30
SNIFLOT_WATCH_INTERVAL=60

# Wildberries: region/warehouse for prices and stock (-1257786 = Moscow)
SNIFLOT_WB_ENABLED=true
SNIFLOT_WB_DEST=-1257786
# Override if WB moves its search endpoint again (comma separated, tried in order)
# SNIFLOT_WB_SEARCH_URLS=https://search.wb.ru/exactmatch/ru/common/v18/search

# Avito (see docs/sources.md). backend: http, or browser (default in the full image)
SNIFLOT_AVITO_ENABLED=true
# SNIFLOT_AVITO_BACKEND=browser
SNIFLOT_AVITO_REGION=all
SNIFLOT_AVITO_MIN_INTERVAL=30

# Ozon needs the browser (full image). Seconds between page loads:
SNIFLOT_OZON_ENABLED=true
SNIFLOT_OZON_MIN_INTERVAL=20

# Browser: the full image runs a visible Chromium on a virtual display (Xvfb).
# Its profile (cookies) lives in /data/browser.
# SNIFLOT_BROWSER_HEADLESS=false
# SNIFLOT_BROWSER_TIMEOUT=45

# Image variant for docker compose: full (Ozon + Avito via browser) or slim
# SNIFLOT_TARGET=full
